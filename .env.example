# Copy to .env for local development. Never commit the real file — .env is
# already in .gitignore. On Render these are set in the dashboard instead.

# ---------------------------------------------------------------- database --
# Postgres connection string, used by BOTH the API and the fetcher.
# Render provides this automatically to services created from render.yaml.
# Leave it unset locally and the fetcher writes flat JSON files as before.
#
#   local:  postgresql://postgres:postgres@localhost:5432/inflation
#   render: copy the "External Database URL" from the database page
DATABASE_URL=

# ------------------------------------------------------------ commentary ---
# Optional. Without it the fetcher still runs and simply writes no LLM note.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ------------------------------------------------------------------- API ---
# Comma-separated list of origins allowed to call the API from a browser.
# "*" is fine for public read-only data; narrow it to your own domain to be
# tidy, e.g. https://uk-inflation-web.onrender.com
ALLOWED_ORIGINS=*

# How long the API holds a payload in memory before re-reading Postgres,
# and how long browsers are told to cache a response. Seconds.
CACHE_TTL_SECONDS=60
BROWSER_CACHE_SECONDS=300

# -------------------------------------------------------------- frontend ---
# Where the built site looks for data. Leave blank to use the static JSON
# files in web/public/data (the original local-only behaviour).
# On Render set this to the API service URL, e.g.
#   https://uk-inflation-api.onrender.com
VITE_API_BASE_URL=
